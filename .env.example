# ---- API authentication -------------------------------------------------
# REQUIRED. When set, clients must send header: X-API-Key: <value>
# The API refuses to start if this is empty, unless CHURN_ALLOW_ANONYMOUS=1 is
# set explicitly — an unset key would otherwise disable auth on every endpoint.
CHURN_API_KEY=

# Escape hatch for local development ONLY. Set to 1 to run with no auth at all.
# CHURN_ALLOW_ANONYMOUS=1

# Optional dedicated credential for /admin/reload-model. When set, the regular
# prediction key no longer grants admin access. Falls back to CHURN_API_KEY.
# CHURN_ADMIN_API_KEY=

# ---- Artifact integrity (REQUIRED) --------------------------------------
# HMAC-SHA256 key for signing and verifying model bundles. Verification runs
# BEFORE the model is unpickled, which is what stops a writable models/ volume
# from becoming remote code execution in the API process.
#
# Fail-closed: without this key the API cannot load a model and promotion cannot
# write one. That is deliberate — a missing key must not silently downgrade to
# "load whatever is on disk". Generate one with:
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Use the SAME value everywhere that trains, promotes or serves; a mismatch makes
# every existing bundle fail verification.
CHURN_ARTIFACT_SIGNING_KEY=

# Escape hatch for local experiments ONLY. Allows an unsigned bundle to be
# swapped in and loaded. Never set this in a deployment.
# CHURN_ALLOW_UNSIGNED_MODEL=1

# ---- Pseudonymisation (REQUIRED) ----------------------------------------
# Salt for the subject key that links a customer's prediction rows without
# storing the customer id. Also fail-closed: with no salt, an unsalted hash would
# be trivially reversible against a known customer-id list.
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Rotating this orphans existing rows — an erasure request will no longer find
# predictions written under the previous salt.
CHURN_SUBJECT_KEY_SALT=

# ---- Request schema compatibility ---------------------------------------
# The request schema is generated from the champion's feature_schema. Fields the
# current model no longer uses are accepted and ignored so clients written
# against an older champion keep working; usage is counted on
# churn_deprecated_request_fields_total. Set to 1 to reject them instead, once
# that counter shows no caller sends them.
# CHURN_STRICT_REQUEST_SCHEMA=1

# ---- Limits -------------------------------------------------------------
# Set to 1/true/yes to disable rate limiting (e.g. benchmarking). "0" keeps it on.
CHURN_DISABLE_RATE_LIMIT=

# Reject request bodies larger than this many bytes (default 8 MiB).
# CHURN_MAX_BODY_BYTES=8388608

# Max rows returned by /explain/global regardless of ?limit= (default 200).
# CHURN_MAX_GLOBAL_IMPORTANCE_FEATURES=200

# ---- Training / paths ---------------------------------------------------
# Optional overrides; defaults live in src/churn_system/config/settings.yaml
# CHURN_RAW_DATA_PATH=data/Telco_customer_churn_raw.csv
# CHURN_EXPERIMENTS_DIR=models/experiments
# CHURN_TRAINING_REFERENCE_PATH=data/training_reference.csv
# CHURN_PRODUCTION_MODEL_PATH=models/production/current/model.pkl
# CHURN_EVENT_STORE_DATABASE_URL=sqlite:///./data/churn_events.db

# ---- PostgreSQL (multi-replica deployments) ------------------------------
# SQLite is single-writer and single-host: it cannot back more than one API
# replica. Switching to PostgreSQL also switches scheduler leader election from a
# per-host file lock to a cluster-wide advisory lock, which is what makes running
# more than one lifecycle process safe.
#
# Requires the driver:  pip install "churn-ml-system[postgres]"
# CHURN_EVENT_STORE_DATABASE_URL=postgresql+psycopg://churn:churn@postgres:5432/churn_events

# Outbox worker tuning.
# CHURN_OUTBOX_LEASE_SECONDS=60
# CHURN_OUTBOX_MAX_ATTEMPTS=5
