# ============================================================
# Churn ML System — .gitignore
# ============================================================

# ---------------------- Python bytecode ----------------------
__pycache__/
*.py[codz]
*$py.class
*.so

# -------------------- Virtual environments -------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------- Distribution / build --------------------
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
sdist/
MANIFEST
.Python
develop-eggs/

# ------------------- Test / coverage -------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml

# ------------------- Linting / type checking -----------------
.ruff_cache/
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# ==================== PROJECT-SPECIFIC =======================

# ---- Trained model artifacts (binary, large, reproducible) --
*.pkl
models/experiments/
models/production/
models/monitoring/
models/lineage/

# ---- MLflow local tracking store (14 MB+, fully regenerable) -
mlruns/

# ---- Runtime data (databases, logs, inference outputs) ------
data/churn_events.db
data/inference_logs/
data/training_reference.csv
data/retraining_dataset.csv
logs/

# ---- Raw dataset (large CSV — track via DVC or Git LFS) -----
data/Telco_customer_churn_raw.csv

# ---- Environment & secrets ----------------------------------
.env
.envrc
*.env.local

# ---- Editor / IDE -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- AI agent metadata (GitNexus, Claude, Cursor) -----------
.gitnexus/
.claude/
.cursorignore
.cursorindexingignore

# ---- OS files -----------------------------------------------
.DS_Store
Thumbs.db

# ---- Jupyter ------------------------------------------------
.ipynb_checkpoints/

# ---- Docker (not the Dockerfiles, just runtime) -------------
docker-compose.override.yml
